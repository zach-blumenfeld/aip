{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uuid:94bc0f33-c889-4364-b986-7d31763e56cc",
  "title": "Research-before-coding workflow",
  "description": "Workflow Instruction: search for existing tools, libraries, and patterns before writing custom code. Used at the start of features and dependency decisions.",
  "aip": {
    "version": "0.1",
    "tag": "workflow"
  },
  "type": "object",
  "required": [
    "schemaId",
    "title",
    "triggers",
    "scope_and_approval",
    "workflow",
    "decisions",
    "modes",
    "shortcuts",
    "integration_points",
    "examples",
    "anti_patterns"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaId": {
      "type": "string",
      "const": "urn:uuid:94bc0f33-c889-4364-b986-7d31763e56cc"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Conditions under which an agent should activate this workflow."
    },
    "scope_and_approval": {
      "type": "string",
      "minLength": 1,
      "description": "Freeform policy text: what this workflow may and may not do without explicit user approval."
    },
    "workflow": {
      "type": "object",
      "required": ["phases"],
      "additionalProperties": false,
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/phase" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" },
      "description": "Decision matrix: for each signal, the recommended action and how to handle approval."
    },
    "modes": {
      "type": "object",
      "required": ["quick", "full"],
      "additionalProperties": false,
      "properties": {
        "quick": {
          "type": "object",
          "required": ["description", "checks"],
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "description": "Ordered checklist for the inline quick mode."
            }
          }
        },
        "full": {
          "type": "object",
          "required": ["description", "subagent_prompt_template"],
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "subagent_prompt_template": {
              "type": "string",
              "minLength": 1,
              "description": "Freeform template for invoking a research subagent."
            }
          }
        }
      }
    },
    "shortcuts": {
      "type": "string",
      "minLength": 1,
      "description": "Freeform categorized reference list: common needs grouped by category with suggested packages or MCPs."
    },
    "integration_points": {
      "type": "string",
      "minLength": 1,
      "description": "Freeform notes describing how this workflow composes with other agents, skills, or planners."
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/example" },
      "description": "Worked examples showing the need-search-found-action-result trace."
    },
    "anti_patterns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Behaviors to avoid when running this workflow."
    },
    "extensions": {
      "type": "object",
      "description": "Optional doc-specific structure that doesn't fit the strict core (per AIP strict-core / open-extensions pattern)."
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "required": ["phase_id", "name", "activity"],
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "description": "Stable identifier for the phase (e.g., 'need_analysis')."
        },
        "name": { "type": "string", "minLength": 1 },
        "activity": {
          "type": "string",
          "minLength": 1,
          "description": "What the agent does during this phase."
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["signal", "action", "guidance"],
      "additionalProperties": false,
      "properties": {
        "signal": {
          "type": "string",
          "minLength": 1,
          "description": "The condition observed during search/evaluate."
        },
        "action": {
          "type": "string",
          "enum": ["adopt", "extend", "compose", "build"],
          "description": "The recommended decision class."
        },
        "guidance": {
          "type": "string",
          "minLength": 1,
          "description": "How to apply the action, including the approval checkpoint."
        }
      }
    },
    "example": {
      "type": "object",
      "required": ["need", "search", "found", "action", "result"],
      "additionalProperties": false,
      "properties": {
        "need": { "type": "string", "minLength": 1 },
        "search": { "type": "string", "minLength": 1 },
        "found": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 }
      }
    }
  }
}
