{
  "name": "aip-lang",
  "displayName": "AIP procedure language",
  "description": "Syntax highlighting and compiler diagnostics for .aip procedure files, and ```aip fences in Markdown.",
  "version": "0.2.0",
  "publisher": "zach-blumenfeld",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:aip"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node --test test/compiler.test.js test/grammar.test.js",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "aip",
        "aliases": [
          "AIP",
          "aip"
        ],
        "extensions": [
          ".aip"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aip",
        "scopeName": "source.aip",
        "path": "./syntaxes/aip.tmLanguage.json"
      },
      {
        "scopeName": "markdown.aip.codeblock",
        "path": "./syntaxes/aip.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.aip": "aip"
        }
      }
    ],
    "commands": [
      {
        "command": "aip.check",
        "title": "AIP: Check the procedure"
      },
      {
        "command": "aip.showVersion",
        "title": "AIP: Show the compiler's version"
      }
    ],
    "configuration": {
      "title": "AIP",
      "properties": {
        "aip.command": {
          "type": "string",
          "default": "aip",
          "description": "The aip command the extension runs as `aip compile --check --json --stdin`: a name on PATH, a path, or several words such as `uv run aip`."
        },
        "aip.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "How long after the last edit the procedure is checked, in milliseconds."
        }
      }
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "keyword.control.step.aip",
              "keyword.control.loop.aip"
            ],
            "settings": {
              "foreground": "#FF7AB2",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "entity.name.function.step.aip",
              "entity.name.function.loop.aip"
            ],
            "settings": {
              "foreground": "#E6E6E6"
            }
          },
          {
            "scope": [
              "keyword.other.clause.aip",
              "keyword.control.flow.aip",
              "keyword.other.with.aip",
              "keyword.other.aggregate.aip"
            ],
            "settings": {
              "foreground": "#6CB6FF"
            }
          },
          {
            "scope": [
              "support.type.aip",
              "support.type.answer.aip"
            ],
            "settings": {
              "foreground": "#4EC9B0"
            }
          },
          {
            "scope": [
              "variable.other.key.aip",
              "variable.other.member.aip"
            ],
            "settings": {
              "foreground": "#DCDCAA"
            }
          },
          {
            "scope": "variable.other.constant.aip",
            "settings": {
              "foreground": "#B5CEA8"
            }
          },
          {
            "scope": "constant.other.label.aip",
            "settings": {
              "foreground": "#CE9178"
            }
          },
          {
            "scope": "string.unquoted.path.aip",
            "settings": {
              "foreground": "#CE9178"
            }
          },
          {
            "scope": "variable.other.interpolation.aip",
            "settings": {
              "foreground": "#D7BA7D",
              "fontStyle": "italic"
            }
          },
          {
            "scope": [
              "keyword.operator.arrow.aip",
              "keyword.operator.comparison.aip",
              "keyword.operator.assignment.aip"
            ],
            "settings": {
              "foreground": "#6CB6FF"
            }
          }
        ],
        "[*Light*]": {
          "textMateRules": [
            {
              "scope": [
                "keyword.control.step.aip",
                "keyword.control.loop.aip"
              ],
              "settings": {
                "foreground": "#C2185B",
                "fontStyle": "bold"
              }
            },
            {
              "scope": [
                "entity.name.function.step.aip",
                "entity.name.function.loop.aip"
              ],
              "settings": {
                "foreground": "#1F1F1F"
              }
            },
            {
              "scope": [
                "keyword.other.clause.aip",
                "keyword.control.flow.aip",
                "keyword.other.with.aip",
                "keyword.other.aggregate.aip"
              ],
              "settings": {
                "foreground": "#0B5FBE"
              }
            },
            {
              "scope": [
                "support.type.aip",
                "support.type.answer.aip"
              ],
              "settings": {
                "foreground": "#0F7B6C"
              }
            },
            {
              "scope": [
                "variable.other.key.aip",
                "variable.other.member.aip"
              ],
              "settings": {
                "foreground": "#795E26"
              }
            },
            {
              "scope": "variable.other.constant.aip",
              "settings": {
                "foreground": "#2E7D32"
              }
            },
            {
              "scope": "constant.other.label.aip",
              "settings": {
                "foreground": "#A31515"
              }
            },
            {
              "scope": "string.unquoted.path.aip",
              "settings": {
                "foreground": "#A31515"
              }
            },
            {
              "scope": "variable.other.interpolation.aip",
              "settings": {
                "foreground": "#8A6D1F",
                "fontStyle": "italic"
              }
            },
            {
              "scope": [
                "keyword.operator.arrow.aip",
                "keyword.operator.comparison.aip",
                "keyword.operator.assignment.aip"
              ],
              "settings": {
                "foreground": "#0B5FBE"
              }
            }
          ]
        }
      }
    }
  }
}
