{
  "name": "aip-console",
  "version": "0.9.0",
  "description": "The AIP console (formerly inspector): catalog, card canvas, source, run console, history and audit for an AIP server, or local runs of a procedure folder.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zach-blumenfeld/aip.git",
    "directory": "console"
  },
  "homepage": "https://github.com/zach-blumenfeld/aip/tree/main/console#readme",
  "bugs": {
    "url": "https://github.com/zach-blumenfeld/aip/issues"
  },
  "type": "module",
  "bin": {
    "aip-console": "bin/aip-console.mjs",
    "aip-inspector": "bin/aip-console.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node bin/aip-console.mjs",
    "typecheck": "tsc -b",
    "test": "node --test \"test/*.test.ts\" \"test/*.test.mjs\"",
    "e2e": "playwright test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
