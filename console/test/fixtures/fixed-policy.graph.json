   ],
   "properties": {
    "id": "question:check.claims",
    "bundle_id": "2a24c7a244e6811c75340bfcb49f608799fc8918bae2f646c04bce14183d9297",
    "name": "claims",
    "type": "true_or_false",
    "instruction": "The work stays within the approved claims about the product: every factual claim it makes about the product is one of the approved claims below, or follows from one, and it promises nothing beyond them. Work that makes no claim about the product stays within them.\n\nApproved claims:\n- A duplicate charge is refunded in full to the original payment method within 5 business days.\n- A subscription can be cancelled at any time and stays active until the end of the paid period.\n- Support answers email within one business day.\n- An annual plan costs less per month than a monthly plan.\n- Account data can be exported from the settings page.",
    "order": 1,
    "line": 60,
    "column": 7,
    "end_line": 60,
    "end_column": 42
   }
  },
  {
