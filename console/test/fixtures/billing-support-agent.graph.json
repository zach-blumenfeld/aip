   "properties": {
    "id": "procedure",
    "bundle_id": "6e98638919e8fdeb81c8f0b06626162323fd8dd69ae6f95d7f0791ad9cbaaad2",
    "name": "billing_support_agent",
    "description": "Turn an inbound billing message into either a tier-2 ticket or a drafted reply.\n   The agent classifies the message; a script opens the ticket; the agent drafts\n   the reply against the refund policy.",
    "language_version": "0.9",
    "compiler_version": "0.9.0",
    "use_when": [
     "A customer message about a charge, invoice, refund, or subscription arrives.",
     "Support asks to triage a billing complaint, and no decision model is configured."
    ],
    "do_not_use_when": [
     "The message is about product bugs or feature requests rather than billing."
    ],
    "avoid": [
     "Replying to an angry customer with a templated answer instead of escalating.",
     "Promising a refund the policy does not cover."
    ],
    "requires_interpreter": "python",
    "requires_version": "3.10",
    "line": 11,
    "column": 1,
    "end_line": 74,
    "end_column": 1
   }
