# build_procedure/procedure.aip
#
# The procedure that builds a procedure from a brief and a folder of documents. Whoever runs it
# answers its tasks: an agent reads, writes and reviews, and answers `ask_user` itself from the
# brief or takes it to a person (`aip agent` answers them all with its model; the console's Studio
# hands `ask_user` to the person). Scripts read the documents, write the files the agent answers
# with (the agent needs no tools), compile the folder and try it once without running any of the
# scripts it wrote. It uses no decision model: the loops watch answers the agent and the compiler
# give.
#
# Two loops, both in the one shape: the check inside the loop, `Until` watching its answer.
# `clarify` extracts the rules and asks a person what they leave open; it ends the moment the
# extraction says nothing is left to ask, or after two rounds of questions (`At_Most 2,
# Else_Exit`), and `draft` reads the last round's answers either way. `revise` compiles and
# fixes; `At_Most 5` is four checked fixes.
#
# It ships inside the package as a bundle (src/aip/server/bundles/build_procedure.rl, compiled
# from this folder), as make_procedure does.

Procedure build_procedure
  "Build an AIP procedure from a brief and a folder of documents: read them, settle the rules with a person, write the folder, compile it until it does, try it once, and review it against the rules."

  Use_When
    "A new procedure is to be built from a brief and source documents (a policy, a runbook, a handbook), with a person answering what the documents leave open."
    "An agent is to do the writing, with the language page this procedure hands it."
  Do_Not_Use_When
    "An existing procedure is to be changed: use edit_procedure."
  Requires python 3.10
  Avoid
    "Inventing rules that neither the documents nor the person's answers give."
    "Reporting the procedure as built before the compile step has said it compiles."

Start "What to build, from what, and where to write it." {
  brief: string     "What the procedure should do, in the requester's words."
  documents: string "A folder under the working directory holding the source documents; an empty string when there are none."
  out: string       "The folder to write the procedure into, under the working directory."
  title: string     "The procedure's name if the requester gave one; an empty string lets the model name it from the brief's subject."
  Next_Step prepare
}

Execute prepare "Read the documents, tidy the name the requester gave, and open an empty record of the person's answers." {
  Read documents, title
  Run_Script scripts/prepare.py
  Produce files:   list   "The documents' paths, relative to the working directory."
          texts:   string "The documents' text, each under a heading with its path."
          name:    string "The requester's name for the procedure, lowercase, with underscores; empty when they gave none."
          answers: string "The person's answers to the questions so far; none yet."
  Next_Step read_documents
}

Task_Agent read_documents "Read the documents and write down what they say that bears on the brief." {
  Read brief, files, texts
  Prompt assets/read_documents.md
  Produce notes: string "What the documents say that bears on the brief: rules, limits, roles, cases, each with the file it is from."
  Next_Step clarify
}

Loop clarify Until settled, At_Most 2, Else_Exit {
  Task_Agent extract_rules "Turn the brief, the notes and the answers so far into the procedure's rules, and list what is still open." {
    Read brief, notes, answers
    Prompt assets/extract_rules.md
    Produce rules:     string        "The rules: each decision, who makes it, on what, and what follows from it; who does each piece of work."
            questions: list          "What the brief, the documents and the answers leave open, one question each; empty when nothing is."
            settled:   true_or_false "Whether nothing is left to ask: true exactly when questions is empty."
    Next_Step ask_user
  }

  Task_Agent ask_user "A person answers the questions the rules leave open." {
    Read questions, rules
    Prompt assets/ask_user.md
    Produce answers: string "The person's answers, numbered as the questions are."
    Continue
  }

  Next_Step draft
}

Task_Agent draft "Name the procedure and write its folder from the rules." {
  Read brief, notes, rules, answers, out, name
  Prompt assets/draft.md
  Use references/language.md "The AIP language on one page: the law for what the folder holds."
  Produce procedure: string "The procedure's name, as its header says."
          drafted:   object "Every file of the folder, by its path in the folder, as its whole text."
  Next_Step write
}

Execute write "Write the drafted files into the folder." {
  Read out, drafted
  Run_Script scripts/write.py
  Produce path:  string "The procedure's folder, relative to the working directory."
          saved: list   "The files written, by their path in the folder."
  Next_Step revise
}

Loop revise Until compiled, At_Most 5, Else_Fail {
  Execute compile "Compile the folder and report what the compiler says; the folder is left as it was written." {
    Read path
    Run_Script scripts/compile.py
    Produce compiled:    true_or_false "Whether the folder compiles with no error."
            diagnostics: list          "The compiler's diagnostics, one line each: where, severity, code, message."
            bundle_id:   string        "The id of the bundle the folder compiles to; empty when it does not compile."
            contents:    object        "Every text file of the folder as it is now, by its path in the folder."
    Next_Step fix
  }

  Task_Agent fix "Fix what the compiler reported, keeping to the rules." {
    Read path, diagnostics, rules, contents
    Prompt assets/fix.md
    Use references/language.md "The AIP language on one page."
    Produce repairs: object "The files to replace, by their path in the folder, each as its whole new text."
    Next_Step apply
  }

  Execute apply "Write the repaired files into the folder." {
    Read path, repairs
    Run_Script scripts/write.py
    Produce applied: list "The files written, by their path in the folder."
    Continue
  }

  Next_Step test_run
}

Execute test_run "Try the new procedure once on example inputs, running none of its scripts, answering nothing, and report how far it gets." {
  Read path
  Run_Script scripts/test_run.py
  Produce started:     boolean "Whether the run got past its Start step."
          test_report: string  "Where the trial stopped (its end, the first pause, the first script it would run, or an error), and what each script says it does."
  Next_Step review
}

Task_Agent review "Read the procedure once more against the rules and say what it does not cover." {
  Read path, rules, test_report, contents
  Prompt assets/review.md
  Produce review: string "What the procedure covers, what it does not, what each script touches outside the working directory, and what a person should check before it is published."
  Next_Step end
}

End "The procedure's folder and name, the bundle it compiles to, how its trial went, and the review." {
  Read path, procedure, bundle_id, test_report, review
}
